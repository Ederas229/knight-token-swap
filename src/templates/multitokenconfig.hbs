<div class='flexcol'>
  <div class='form-group'>
    <label>{{localize 'TOKENSWAP.Wear.armure'}}</label>
    <div class='form-fields'>
      <file-picker type='imagevideo' name='armure' placeholder='path/image.png' value='{{files.armure}}'></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <label>{{localize 'TOKENSWAP.Wear.guardian'}}</label>
    <div class='form-fields'>
      <file-picker
        type='imagevideo'
        name='guardian'
        placeholder='path/image.png'
        value='{{files.guardian}}'
      ></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <label>{{localize 'TOKENSWAP.Wear.tenueCivile'}}</label>
    <div class='form-fields'>
      <file-picker
        type='imagevideo'
        name='tenueCivile'
        placeholder='path/image.png'
        value='{{files.tenueCivile}}'
      ></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <button type='submit' name='save'>
      <i class='far fa-save'></i>
      {{localize 'TOKENSWAP.Save'}}
    </button>
    <button type='submit' name='reset'>
      <i class='far fa-trash'></i>
      {{localize 'TOKENSWAP.Reset'}}
    </button>
  </div>
</div>
