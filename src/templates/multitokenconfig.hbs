<div class='flexcol'>
  <div class='form-group'>
    <label>Meta-armure</label>
    <div class='form-fields'>
      <file-picker type='imagevideo' name='armure' placeholder='path/image.png' value='{{files.armure}}'></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <label>Guardian</label>
    <div class='form-fields'>
      <file-picker
        type='imagevideo'
        name='guardian'
        placeholder='path/image.png'
        value='{{files.guardian}}'
      ></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <label>Tenue Civile</label>
    <div class='form-fields'>
      <file-picker
        type='imagevideo'
        name='tenueCivile'
        placeholder='path/image.png'
        value='{{files.tenueCivile}}'
      ></file-picker>
    </div>
  </div>
  <div class='form-group'>
    <button type='submit' name='save'>
      <i class='far fa-save'></i>
      Save
    </button>
    <button type='submit' name='reset'>
      <i class='far fa-trash'></i>
      Reset
    </button>
  </div>
</div>
